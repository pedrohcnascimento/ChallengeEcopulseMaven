classDiagram
    class User {
        -Long id
        -String externalId
        -String username
        -String login
        -String passwordHash
        -String name
        -LocalDate birthDate
        -String cpf
        -String nationality
        -String email
        -Long familyId
        -Instant createdAt
        -Instant updatedAt
        +getDisplayName() String
        +hasCompleteProfile() boolean
        +isValidEmail() boolean
        +isValidCpf() boolean
    }
    class Family {
        -Long id
        -String name
        -String relationshipDescription
    }
    class Avatar {
        -Long id
        -Long userId
        -String name
        -String visualConfig
        -String personalityType
        -Integer level
        -Long experiencePoints
        -Instant createdAt
        -Instant updatedAt
        +isEvolved() boolean
        +getExperienceToNextLevel() long
        +addExperience(long) void
    }
    class Mission {
        -Long id
        -String title
        -String description
        -String type
        -String rules
        -Instant startDate
        -Instant endDate
        -String status
        -Instant createdAt
        -Instant updatedAt
        +isEligible(Instant) boolean
        +activate() void
        +deactivate() void
    }
    class Reward {
        -Long id
        -String name
        -String description
        -String type
        -Integer value
        -String details
    }
    class MissionReward {
        -Long missionId
        -Long rewardId
    }
    class UserMission {
        -Long id
        -Long userId
        -Long missionId
        -String status
        -Integer progress
        -Instant completedAt
        -Instant assignedAt
    }
    class UserReward {
        -Long id
        -Long userId
        -Long rewardId
        -Long sourceMissionId
        -Instant acquiredAt
        -Boolean isClaimed
    }
    class Activity {
        -Long id
        -Long userId
        -String type
        -Instant timestamp
        -String metadata
    }
    class Streak {
        -Long id
        -Long userId
        -String type
        -Integer currentCount
        -Integer highestCount
        -Instant lastActivityAt
    }
    class Community {
        -Long id
        -String name
        -String description
        -String communityType
        -Instant createdAt
    }
    class UserCommunity {
        -Long userId
        -Long communityId
    }
    class MissionCommunity {
        -Long missionId
        -Long communityId
        -Integer score
        -String status
    }
    class Post {
        -Long id
        -Long userId
        -String content
        -String status
        -Instant createdAt
        -Instant updatedAt
    }
    class PostCounter {
        -Long id
        -Long postId
        -Integer likeCount
        -Integer commentCount
        -Integer shareCount
    }
    class ConversationHistory {
        -Long id
        -Long userId
        -String content
        -Instant sentAt
        -String recipient
    }
    class CorsFilter {
        +doFilter(ServletRequest, ServletResponse, FilterChain) void
    }
    class ConnectionFactory {
        +getConnection() Connection
        +executeInTransaction(Supplier) T
        +initializeDatabase() void
        +clearData() void
    }

    Family "0..1" <-- "0..*" User : familyId
    User "1" <-- "0..*" Avatar : userId
    User "1" <-- "0..*" Activity : userId
    User "1" <-- "0..*" Streak : userId
    User "1" <-- "0..*" Post : userId
    Post "1" <-- "1" PostCounter : postId
    User "1" <-- "0..*" ConversationHistory : userId
    Mission "1" <-- "1..*" MissionReward : missionId
    Reward "1" <-- "0..*" MissionReward : rewardId
    User "1" <-- "0..*" UserMission : userId
    Mission "1" <-- "0..*" UserMission : missionId
    User "1" <-- "0..*" UserReward : userId
    Reward "1" <-- "0..*" UserReward : rewardId
    User "1" <-- "0..*" UserCommunity : userId
    Community "1" <-- "0..*" UserCommunity : communityId
    Mission "1" <-- "0..*" MissionCommunity : missionId
    Community "1" <-- "0..*" MissionCommunity : communityId
