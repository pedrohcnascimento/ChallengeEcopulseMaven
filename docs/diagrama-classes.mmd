classDiagram
    direction TB

    class Family {
        -Long id
        -String name
        -String relationshipDescription
        +validate() void
    }

    class User {
        -Long id
        -String externalId
        -String username
        -String login
        -String passwordHash
        -String name
        -LocalDate birthDate
        -String cpf
        -String nationality
        -String email
        -Long familyId
        -Instant createdAt
        -Instant updatedAt
        +getDisplayName() String
        +hasCompleteProfile() boolean
        +isValidEmail() boolean
        +isValidCpf() boolean
        +updateProfile(String, String) void
    }

    class Avatar {
        -Long id
        -Long userId
        -String name
        -String visualConfig
        -String personalityType
        -Integer level
        -Long experiencePoints
        -Instant createdAt
        -Instant updatedAt
        +getDisplayName() String
        +isEvolved() boolean
        +getExperienceToNextLevel() long
        +addExperience(long) void
    }

    class Mission {
        -Long id
        -String title
        -String description
        -String type
        -String rules
        -Instant startDate
        -Instant endDate
        -String status
        -Instant createdAt
        -Instant updatedAt
        +isEligible(Instant) boolean
        +validateInvariants() void
        +activate() void
        +deactivate() void
    }

    class Reward {
        -Long id
        -String name
        -String description
        -String type
        -Integer value
        -String details
        +validate() void
    }

    class MissionReward {
        -Long missionId
        -Long rewardId
    }

    class UserMission {
        -Long id
        -Long userId
        -Long missionId
        -String status
        -Integer progress
        -Instant completedAt
        -Instant assignedAt
        +updateProgress(int) void
        +markCompleted() void
    }

    class UserReward {
        -Long id
        -Long userId
        -Long rewardId
        -Long sourceMissionId
        -Instant acquiredAt
        -Boolean isClaimed
        +claim() void
    }

    class Activity {
        -Long id
        -Long userId
        -String type
        -Instant timestamp
        -String metadata
        +validate() void
    }

    class Streak {
        -Long id
        -Long userId
        -String type
        -Integer currentCount
        -Integer highestCount
        -Instant lastActivityAt
        -Instant createdAt
        -Instant updatedAt
        +registerActivity(Instant) void
    }

    class Community {
        -Long id
        -String name
        -String description
        -String communityType
        -Instant createdAt
        +validate() void
    }

    class UserCommunity {
        -Long userId
        -Long communityId
    }

    class MissionCommunity {
        -Long missionId
        -Long communityId
        -Integer score
        -String status
        +validate() void
    }

    class Post {
        -Long id
        -Long userId
        -String content
        -String status
        -Instant createdAt
        -Instant updatedAt
        +validate() void
    }

    class PostCounter {
        -Long id
        -Long postId
        -Integer likeCount
        -Integer commentCount
        -Integer shareCount
        +incrementLike() void
        +incrementComment() void
        +incrementShare() void
    }

    class ConversationHistory {
        -Long id
        -Long userId
        -String content
        -Instant sentAt
        -String recipient
        +validate() void
    }

    class EcoPulseException {
        <<RuntimeException>>
        +EcoPulseException(String)
    }
    class DomainValidationException {
        +DomainValidationException(String)
    }
    class ResourceNotFoundException {
        +ResourceNotFoundException(String)
    }
    class BusinessConflictException {
        +BusinessConflictException(String)
    }
    class AuthenticationException {
        +AuthenticationException(String)
    }
    class PersistenceException {
        +PersistenceException(String, Throwable)
    }

    Family "0..1" <-- "0..*" User : familyId
    User "1" <-- "0..*" Avatar : userId
    User "1" <-- "0..*" Activity : userId
    User "1" <-- "0..*" Streak : userId
    User "1" <-- "0..*" Post : userId
    Post "1" *-- "1" PostCounter : postId
    User "1" <-- "0..*" ConversationHistory : userId
    Mission "1" *-- "1..*" MissionReward : missionId
    Reward "1" <-- "0..*" MissionReward : rewardId
    User "1" <-- "0..*" UserMission : userId
    Mission "1" <-- "0..*" UserMission : missionId
    User "1" <-- "0..*" UserReward : userId
    Reward "1" <-- "0..*" UserReward : rewardId
    Mission "0..1" <-- "0..*" UserReward : sourceMissionId
    User "1" <-- "0..*" UserCommunity : userId
    Community "1" <-- "0..*" UserCommunity : communityId
    Mission "1" <-- "0..*" MissionCommunity : missionId
    Community "1" <-- "0..*" MissionCommunity : communityId

    EcoPulseException <|-- DomainValidationException
    EcoPulseException <|-- ResourceNotFoundException
    EcoPulseException <|-- BusinessConflictException
    EcoPulseException <|-- AuthenticationException
    EcoPulseException <|-- PersistenceException
