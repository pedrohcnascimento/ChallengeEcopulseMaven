    T_SOUL_FAMILIA {
        NUMBER cd_familia PK
        VARCHAR2 nm_familia
        VARCHAR2 ds_parentesco
    }
    T_SOUL_USUARIO {
        NUMBER cd_usuario PK
        VARCHAR2 external_id
        VARCHAR2 username
        VARCHAR2 ds_login UK
        VARCHAR2 ds_senha
        VARCHAR2 nm_usuario
        DATE dt_nascimento
        VARCHAR2 nr_cpf UK
        VARCHAR2 ds_nacionalidade
        VARCHAR2 ds_email UK
        NUMBER cd_familia FK
        TIMESTAMP dt_criacao
        TIMESTAMP dt_atualizacao
    }
    T_SOUL_AVATAR {
        NUMBER id_avatar PK
        NUMBER cd_usuario FK
        VARCHAR2 nm_avatar
        VARCHAR2 ds_visual_config
        VARCHAR2 ds_personalidade
        NUMBER nr_nivel
        NUMBER nr_xp
        TIMESTAMP dt_criacao
        TIMESTAMP dt_atualizacao
    }
    T_SOUL_DESAFIO {
        NUMBER cd_desafio PK
        VARCHAR2 ds_nomedesafio
        VARCHAR2 ds_descricao
        VARCHAR2 ds_tipo
        VARCHAR2 ds_regras
        TIMESTAMP dt_iniciodesafio
        TIMESTAMP dt_fimdesafio
        VARCHAR2 st_status
        TIMESTAMP dt_criacao
        TIMESTAMP dt_atualizacao
    }
    T_SOUL_REWARD {
        NUMBER id_reward PK
        VARCHAR2 nm_reward
        VARCHAR2 ds_reward
        VARCHAR2 tp_reward
        NUMBER vl_reward
        VARCHAR2 ds_detalhes
    }
    T_SOUL_DESAFIO_REWARD {
        NUMBER cd_desafio PK,FK
        NUMBER id_reward PK,FK
    }
    T_SOUL_USUARIO_DESAFIO {
        NUMBER id_usuario_desafio PK
        NUMBER cd_usuario FK
        NUMBER cd_desafio FK
        VARCHAR2 st_participacao
        NUMBER nr_progresso
        TIMESTAMP dt_conclusao
        TIMESTAMP dt_atribuicao
    }
    T_SOUL_USUARIO_REWARD {
        NUMBER id_usuario_reward PK
        NUMBER cd_usuario FK
        NUMBER id_reward FK
        NUMBER cd_desafio_origem FK
        TIMESTAMP dt_aquisicao
        NUMBER fl_resgatada
    }
    T_SOUL_ACTIVITY {
        NUMBER id_activity PK
        NUMBER cd_usuario FK
        VARCHAR2 tp_atividade
        TIMESTAMP dt_atividade
        VARCHAR2 ds_metadata
    }
    T_SOUL_STREAK {
        NUMBER id_streak PK
        NUMBER cd_usuario FK
        VARCHAR2 tp_streak
        NUMBER nr_atual
        NUMBER nr_recorde
        TIMESTAMP dt_ultima_atividade
        TIMESTAMP dt_criacao
        TIMESTAMP dt_atualizacao
    }
    T_SOUL_COMUNIDADE {
        NUMBER cd_comunidade PK
        VARCHAR2 nm_comunidade UK
        VARCHAR2 ds_comunidade
        VARCHAR2 tp_comunidade
        TIMESTAMP dt_criacao
    }
    T_SOUL_USUARIO_COMUN {
        NUMBER cd_usuario PK,FK
        NUMBER cd_comunidade PK,FK
    }
    T_SOUL_DESAFIO_COMUN {
        NUMBER cd_desafio PK,FK
        NUMBER cd_comunidade PK,FK
        NUMBER nr_pontuacao
        VARCHAR2 st_status
    }
    T_SOUL_POSTS {
        NUMBER id_post PK
        NUMBER cd_usuario FK
        VARCHAR2 ds_conteudo
        VARCHAR2 st_post
        TIMESTAMP dt_criacao
        TIMESTAMP dt_atualizacao
    }
    T_SOUL_CONTADORES {
        NUMBER id_contador PK
        NUMBER id_post FK,UK
        NUMBER nr_curtidas
        NUMBER nr_comentarios
        NUMBER nr_compartilhamentos
    }
    T_SOUL_HISTORICO_CONVERSA {
        NUMBER id_conversa PK
        NUMBER cd_usuario FK
        VARCHAR2 ds_conteudo
        TIMESTAMP dt_envio
        VARCHAR2 ds_destinatario
    }
